predicate table(array[int] of var int: x, array[int, int] of int: t);
predicate int_lin_le(array[int] of int: c, array[int] of var int: x, int: d);
% x1,x2 restricted to the diagonal pairs (1,1),(2,2),(3,3), but the linear
% constraint forces x1+x2 <= 3 with x1,x2 >= 2 -> no table row satisfies it.
var 1..3: x1 :: output_var;
var 1..3: x2 :: output_var;
constraint int_lin_le([1, 1], [x1, x2], 3);
constraint int_lin_le([-1], [x1], -2);
constraint int_lin_le([-1], [x2], -2);
constraint table([x1, x2], array2d(1, 3, 1, 2, [1,1, 2,2, 3,3]));
solve satisfy;

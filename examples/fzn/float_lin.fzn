% Continuous linear FlatZinc example: x[2] = 1.5*x[1], x[1] >= 1.
predicate float_lin_eq(array[int] of float: c, array[int] of var float: x, float: d);
predicate float_lin_ge(array[int] of float: c, array[int] of var float: x, float: d);

array [1..2] of var -5.0..5.0: x :: output_array([1..2]);
constraint float_lin_eq([1.5, -1.0], x, 0.0);
constraint float_lin_ge([1.0, 0.0], x, 1.0);
solve minimize x[2];

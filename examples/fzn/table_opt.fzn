predicate table(array[int] of var int: x, array[int, int] of int: t);
predicate int_lin_eq(array[int] of int: c, array[int] of var int: x, int: d);
% x1,x2,x3 must take one of the four allowed (x1,x2,x3) rows; obj = x1+x2+x3 is
% introduced via a linear constraint (the form MiniZinc emits after flattening).
var 1..9: x1 :: output_var;
var 1..9: x2 :: output_var;
var 1..9: x3 :: output_var;
var 0..30: obj :: output_var;
constraint int_lin_eq([1, 1, 1, -1], [x1, x2, x3, obj], 0);
constraint table([x1, x2, x3], array2d(1, 4, 1, 3, [1,2,1,  4,3,2,  6,5,3,  3,9,1]));
solve maximize obj;

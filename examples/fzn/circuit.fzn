% A single Hamiltonian successor cycle over nodes 1..4.
predicate gecode_circuit(int: offset, array [int] of var int: x);
var 1..4: s1 :: output_var;
var 1..4: s2 :: output_var;
var 1..4: s3 :: output_var;
var 1..4: s4 :: output_var;
array [1..4] of var int: s :: output_array([1..4]) = [s1,s2,s3,s4];
constraint gecode_circuit(1, s);
solve satisfy;

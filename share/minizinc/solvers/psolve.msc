{
  "id": "org.psolve.fznsolve",
  "name": "psolve",
  "description": "psolve exact & integer FlatZinc/CSP solver — LP/MIP + finite-domain CP engine for any FlatZinc",
  "version": "1.1.0",
  "mznlib": "",
  "executable": "fznsolve",
  "tags": ["mip", "cp", "int", "float", "linear", "par"],
  "stdFlags": ["-a", "-f", "-n", "-p", "-s", "-t", "-v"],
  "supportsMzn": true,
  "supportsFzn": true,
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}

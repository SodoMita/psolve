{
  "id": "org.psolve.fznsolve",
  "name": "psolve",
  "description": "psolve exact & integer FlatZinc solver",
  "version": "1.0.0",
  "mznlib": "-Glinear",
  "executable": "fznsolve",
  "tags": ["mip", "int", "float", "linear"],
  "stdFlags": ["-a", "-f", "-n", "-p", "-s", "-t", "-v"],
  "supportsMzn": false,
  "supportsFzn": true,
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}
